{
  "schema_version": 1,
  "harness": "codex-transfer",
  "suite_id": "codex-symmetric-transfer-v1",
  "formal_protocol_gate": true,
  "trials_per_arm": 1,
  "tasks": [
    {
      "id": "symmetric-rewrite-001",
      "family": "symmetric_instruction_rewriting",
      "expected_skill": "zh-rewrite-v2",
      "prompt": "请阅读 draft.md，把它改写成一段克制、自然的中文运营更新，保存到 outputs/update.md。只保留原文明确写出的开放日期、功能、试用人数和反馈结果；去掉夸张表述、问候、收尾建议和任何推断。保留所有日期、数字和事实，不要标题、列表或修改说明，正文控制在 50 到 180 个字符（含标点）。",
      "hint": "rewrite a Chinese operational update while preserving stated facts",
      "workspace_files": {
        "draft.md": "移动端工作台计划于 11 月 14 日开放测试，首轮包含语音速记和离线搜索。试用共有 36 人，其中 24 人表示离线搜索缩短了查找时间。此外，这是重新定义效率的标志性突破，请告诉我是否继续展开。\n"
      },
      "allowed_changed_paths": ["outputs/update.md"],
      "one_call_load": true,
      "required_find_calls": 1,
      "oracle": {
        "path": "outputs/update.md",
        "minimum_characters": 50,
        "maximum_characters": 180,
        "required_regex": ["^\\s*(?=[\\s\\S]*(?:移动端工作台\\s*(?:计划(?:于|在)?|拟(?:于|在)?)\\s*11\\s*月\\s*14\\s*日\\s*开放\\s*测试|11\\s*月\\s*14\\s*日\\s*[，,]?\\s*移动端工作台\\s*(?:计划|拟)(?:于|在)?\\s*开放\\s*测试))(?=[\\s\\S]*(?:首轮\\s*(?:包含|包括|支持|将(?:会)?\\s*上线)\\s*语音速记\\s*(?:和|及|与)\\s*离线搜索))(?=[\\s\\S]*(?:(?:试用\\s*(?:共有|共计)\\s*36\\s*人\\s*[，,]\\s*其中\\s*24\\s*人|36\\s*名\\s*试用用户\\s*中\\s*[，,]?\\s*24\\s*人|36\\s*名\\s*用户\\s*参与试用\\s*[，,]\\s*其中\\s*24\\s*人)\\s*(?:明确\\s*)?(?:表示|反馈)\\s*离线搜索\\s*缩短\\s*了\\s*查找时间))(?:(?:移动端工作台\\s*(?:计划(?:于|在)?|拟(?:于|在)?)\\s*11\\s*月\\s*14\\s*日\\s*开放\\s*测试|11\\s*月\\s*14\\s*日\\s*[，,]?\\s*移动端工作台\\s*(?:计划|拟)(?:于|在)?\\s*开放\\s*测试)|(?:首轮\\s*(?:包含|包括|支持|将(?:会)?\\s*上线)\\s*语音速记\\s*(?:和|及|与)\\s*离线搜索)|(?:(?:试用\\s*(?:共有|共计)\\s*36\\s*人\\s*[，,]\\s*其中\\s*24\\s*人|36\\s*名\\s*试用用户\\s*中\\s*[，,]?\\s*24\\s*人|36\\s*名\\s*用户\\s*参与试用\\s*[，,]\\s*其中\\s*24\\s*人)\\s*(?:明确\\s*)?(?:表示|反馈)\\s*离线搜索\\s*缩短\\s*了\\s*查找时间))\\s*[。.!！；;，,]?\\s*(?:(?:移动端工作台\\s*(?:计划(?:于|在)?|拟(?:于|在)?)\\s*11\\s*月\\s*14\\s*日\\s*开放\\s*测试|11\\s*月\\s*14\\s*日\\s*[，,]?\\s*移动端工作台\\s*(?:计划|拟)(?:于|在)?\\s*开放\\s*测试)|(?:首轮\\s*(?:包含|包括|支持|将(?:会)?\\s*上线)\\s*语音速记\\s*(?:和|及|与)\\s*离线搜索)|(?:(?:试用\\s*(?:共有|共计)\\s*36\\s*人\\s*[，,]\\s*其中\\s*24\\s*人|36\\s*名\\s*试用用户\\s*中\\s*[，,]?\\s*24\\s*人|36\\s*名\\s*用户\\s*参与试用\\s*[，,]\\s*其中\\s*24\\s*人)\\s*(?:明确\\s*)?(?:表示|反馈)\\s*离线搜索\\s*缩短\\s*了\\s*查找时间))\\s*[。.!！；;，,]?\\s*(?:(?:移动端工作台\\s*(?:计划(?:于|在)?|拟(?:于|在)?)\\s*11\\s*月\\s*14\\s*日\\s*开放\\s*测试|11\\s*月\\s*14\\s*日\\s*[，,]?\\s*移动端工作台\\s*(?:计划|拟)(?:于|在)?\\s*开放\\s*测试)|(?:首轮\\s*(?:包含|包括|支持|将(?:会)?\\s*上线)\\s*语音速记\\s*(?:和|及|与)\\s*离线搜索)|(?:(?:试用\\s*(?:共有|共计)\\s*36\\s*人\\s*[，,]\\s*其中\\s*24\\s*人|36\\s*名\\s*试用用户\\s*中\\s*[，,]?\\s*24\\s*人|36\\s*名\\s*用户\\s*参与试用\\s*[，,]\\s*其中\\s*24\\s*人)\\s*(?:明确\\s*)?(?:表示|反馈)\\s*离线搜索\\s*缩短\\s*了\\s*查找时间))\\s*[。.!！；;，,]?\\s*$"],
        "forbidden_regex": ["^#", "^\\s*[-*+]\\s", "重新定义效率", "标志性突破", "请告诉我", "是否继续展开", "另外\\s*12\\s*人", "开放测试后"]
      }
    },
    {
      "id": "symmetric-extraction-001",
      "family": "symmetric_reference_extraction",
      "expected_skill": "domain-extractor-v2",
      "prompt": "请阅读 memo.txt，按随附的领域格式抽取其中明确出现的术语、定义和关系，保存为 outputs/glossary.json。只使用原文事实，保持首次出现顺序，输出严格 JSON，不要解释或额外字段。",
      "hint": "extract exact domain terms and explicit relationships into JSON",
      "workspace_files": {
        "memo.txt": "Invoice Service 负责生成发票。Audit Stream 接收 Invoice Service 发出的审计记录。Invoice Service 将记录发送至 Audit Stream。\n"
      },
      "allowed_changed_paths": ["outputs/glossary.json"],
      "one_call_load": true,
      "required_find_calls": 1,
      "oracle": {
        "path": "outputs/glossary.json",
        "json_equals": {
          "terms": [
            { "id": "invoice-service", "label": "Invoice Service", "definition": "负责生成发票。", "relations": [{ "type": "emits-record", "target": "audit-stream" }] },
            { "id": "audit-stream", "label": "Audit Stream", "definition": "接收 Invoice Service 发出的审计记录。", "relations": [] }
          ]
        }
      }
    }
  ]
}
